    "build:plugin": "node scripts/build-plugin.mjs",
    "verify:plugin": "node scripts/verify-plugin.mjs",
    "build:release": "node scripts/build-release.mjs",
    "verify:structure": "node scripts/verify-structure.mjs",
    "install:codex": "node scripts/install-codex.mjs",
    "install:agents": "node scripts/install-agents.mjs",
    "start:mcp": "node src/mcp-server.mjs",
    "smoke:live": "node scripts/smoke-e2e.mjs --live"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1",
    "smol-toml": "^1"
  },
  "devDependencies": {
