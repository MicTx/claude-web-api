{
  "name": "claude-web-api",
  "version": "0.2.18",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "description": "通过本地浏览器中的 Claude 网页会话或备用 Messages API 获取第二意见，支持 web/api 两种模式与连续追问。",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ccw": "bin/ccw.mjs"
  },
  "scripts": {
